# 生产环境配置：复制为 .env.prod 后填写。.env.prod 含密钥，不要提交到 git。
# 随机值生成：openssl rand -hex 32

# 镜像版本：latest 为 main 分支最新构建；也可填提交短哈希（如 716ef12）或版本号固定版本
APP_VERSION=latest

# 数据库密码：只用字母和数字（会拼进数据库连接地址）
POSTGRES_PASSWORD=

# 登录令牌签名密钥（至少 32 个字符）
JWT_SECRET_KEY=
# 题目配图 / 上传图片签名链接的密钥（至少 32 个字符）
MEDIA_SIGNING_KEY=
# 加密数据库中保存的 AI 模型 API Key（至少 32 个字符）。设定后不要再改，否则需要在设置页重新填写 API Key
MODEL_KEY_SECRET=

APP_TZ=Asia/Shanghai

# 演示账号（admin/teacher/student@demo.com，密码公开）能否登录，同时控制登录页是否显示演示账号按钮。
# 演示期间为 true；正式使用前改为 false 后执行 up -d
ALLOW_DEMO_LOGIN=true

# 应用前面有几层反向代理（宝塔 / 1Panel / nginx 各算一层），用于取得真实客户端 IP（登录限流、审计日志）。
# 不经反向代理、直接对外开放端口时改为 0
TRUSTED_PROXIES=1

# 应用端口：默认只监听本机 127.0.0.1:8000，由反向代理转发；
# 临时不用反向代理、用 http://IP:8000 直接访问时，把 APP_BIND 改为 0.0.0.0、TRUSTED_PROXIES 改为 0、JWT_COOKIE_SECURE 改为 false
# APP_BIND=127.0.0.1
# APP_PORT=8000
# JWT_COOKIE_SECURE=true
