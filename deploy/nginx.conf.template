# nginx 官方镜像启动时用环境变量替换 ${SERVER_NAME}（只替换已定义的环境变量，nginx 自身的 $host 等不受影响）。
# 证书挂载到 /etc/nginx/certs：fullchain.pem（证书链）与 privkey.pem（私钥）。

server {
    listen 80;
    server_name ${SERVER_NAME};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;

    # 与后端 MAX_CONTENT_LENGTH（10MB）一致
    client_max_body_size 10m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://api:5000;
        proxy_set_header Host $host;
        # 覆盖而不是追加：后端取 X-Forwarded-For 的第一个值作为客户端 IP（登录限流、审计日志），不能让客户端伪造
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # AI 判读同步等待模型返回（后端超时 90 秒）
        proxy_read_timeout 130s;
    }

    # 打包产物文件名带内容哈希，可长期缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 入口页不缓存，发布新版本后用户刷新即可拿到
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 前端路由：找不到文件时回到入口页
    location / {
        try_files $uri $uri/ /index.html;
    }
}
